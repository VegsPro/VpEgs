<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/btn_toggle"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn_circle">
            <ImageView
                android:id="@+id/icon_power"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:tint="#22C55E" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">
            <TextView
                android:id="@+id/txt_country"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#E0F2FE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/txt_ping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#7DD3FC"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_ping"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:background="@drawable/widget_btn_small"
            android:tint="#E0F2FE" />
        <ImageView
            android:id="@+id/btn_refresh"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="@drawable/widget_btn_small"
            android:tint="#E0F2FE" />
        <ImageView
            android:id="@+id/btn_best"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="@drawable/widget_btn_small"
            android:tint="#38BDF8" />
    </LinearLayout>
</LinearLayout>
