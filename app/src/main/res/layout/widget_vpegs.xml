<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:background="@drawable/widget_bg">

    <FrameLayout
        android:id="@+id/btn_toggle"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_btn_circle">
        <ImageView
            android:id="@+id/icon_power"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_media_play"
            android:tint="#22C55E" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">
        <TextView
            android:id="@+id/txt_country"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#F1F5F9"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/txt_ping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#7DD3FC"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <ImageView android:id="@+id/btn_ping" android:layout_width="32dp" android:layout_height="32dp"
        android:padding="5dp" android:clickable="true" android:focusable="true"
        android:src="@android:drawable/ic_menu_recent_history" android:background="@drawable/widget_btn_small" android:tint="#E0F2FE" />
    <ImageView android:id="@+id/btn_refresh" android:layout_width="32dp" android:layout_height="32dp"
        android:layout_marginStart="2dp" android:padding="5dp" android:clickable="true" android:focusable="true"
        android:src="@android:drawable/ic_popup_sync" android:background="@drawable/widget_btn_small" android:tint="#E0F2FE" />
    <ImageView android:id="@+id/btn_best" android:layout_width="32dp" android:layout_height="32dp"
        android:layout_marginStart="2dp" android:padding="5dp" android:clickable="true" android:focusable="true"
        android:src="@android:drawable/ic_menu_sort_by_size" android:background="@drawable/widget_btn_small" android:tint="#38BDF8" />
</LinearLayout>
